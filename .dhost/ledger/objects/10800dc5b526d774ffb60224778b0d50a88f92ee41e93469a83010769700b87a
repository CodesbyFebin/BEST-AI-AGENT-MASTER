  "evidence-methodology": {
    title: "Evidence Methodology — Passage-and-Locator Discipline",
    description: "How BestAIAgent.in collects, classifies, and weighs evidence: STANDARD, COMPARISON, and CRITICAL gates, passage quotations, and freshness windows.",
    blocks: [
      { type: "p", text: "Every material factual claim on BestAIAgent.in is tied to a stored evidence receipt. This page documents the receipts, the evidence gates, and the freshness windows we apply. If a claim has no receipt, we either remove it or mark it unresolved." },
