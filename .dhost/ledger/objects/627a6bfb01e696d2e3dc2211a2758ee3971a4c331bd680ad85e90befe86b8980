<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 500" font-family="Arial, Helvetica, sans-serif">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#080b1b"/>
      <stop offset="1" stop-color="#0d1226"/>
    </linearGradient>
    <linearGradient id="mark" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#536dff"/>
      <stop offset=".55" stop-color="#7c5cff"/>
      <stop offset="1" stop-color="#9b6cff"/>
    </linearGradient>
    <linearGradient id="aiText" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7c9bff"/>
      <stop offset="1" stop-color="#b39cff"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="35%" r="65%">
      <stop offset="0" stop-color="#3a2f7a" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#080b1b" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="1600" height="500" fill="url(#bg)"/>
  <rect width="1600" height="500" fill="url(#glow)"/>
  <rect x="1" y="1" width="1598" height="498" fill="none" stroke="#232c47" stroke-width="1"/>

  <!-- brand mark -->
  <g transform="translate(80,70)">
    <path d="M30 8l5 17 17 5-17 5-5 17-5-17-17-5 17-5z" fill="url(#mark)" transform="scale(1.4)"/>
    <path d="M47 6l2.4 6.6 6.6 2.4-6.6 2.4-2.4 6.6-2.4-6.6-6.6-2.4 6.6-2.4z" fill="#ffffff" transform="scale(1.4)"/>
  </g>

  <!-- wordmark -->
  <text x="150" y="120" font-size="52" font-weight="800" fill="#f4f5ff">
    best <tspan fill="url(#aiText)">ai</tspan> agent<tspan fill="#5b6685" font-size="30" font-weight="700">.in</tspan>
  </text>

  <!-- tagline -->
  <text x="80" y="180" font-size="26" font-weight="700" fill="#e7e9f7">Evidence-first directory for AI agents, models &amp; frameworks</text>
  <text x="80" y="214" font-size="16" fill="#9aa3c4">Unknown stays unknown. No synthetic rankings. No fake reviews. Every indexed entity carries a real, checkable evidence receipt.</text>

  <!-- feature pills -->
  <g font-size="14" font-weight="700" fill="#c8d0ec">
    <g transform="translate(80,250)">
      <rect width="230" height="40" rx="10" fill="#121a33" stroke="#2a3358"/>
      <text x="16" y="26">🔒 SHA-256 evidence receipts</text>
    </g>
    <g transform="translate(325,250)">
      <rect width="230" height="40" rx="10" fill="#121a33" stroke="#2a3358"/>
      <text x="16" y="26">🚦 Evidence-gated indexing</text>
    </g>
    <g transform="translate(570,250)">
      <rect width="230" height="40" rx="10" fill="#121a33" stroke="#2a3358"/>
      <text x="16" y="26">🤖 MCP-aware catalog</text>
    </g>
    <g transform="translate(80,300)">
      <rect width="230" height="40" rx="10" fill="#121a33" stroke="#2a3358"/>
      <text x="16" y="26">📄 Public source on GitHub</text>
    </g>
    <g transform="translate(325,300)">
      <rect width="230" height="40" rx="10" fill="#121a33" stroke="#2a3358"/>
      <text x="16" y="26">🔍 AEO / GEO machine-readable</text>
    </g>
    <g transform="translate(570,300)">
      <rect width="205" height="40" rx="10" fill="#121a33" stroke="#2a3358"/>
      <text x="16" y="26">🇮🇳 India + global coverage</text>
    </g>
  </g>

  <!-- right-side entity type grid (real categories this site covers, no vendor logos, no counts) -->
  <g transform="translate(900,80)">
    <rect width="620" height="330" rx="16" fill="#0e1530" stroke="#252e52"/>
    <text x="28" y="42" font-size="18" font-weight="800" fill="#e7e9f7">What's cataloged here</text>
    <g font-size="14" font-weight="700" fill="#c8d0ec">
      <g transform="translate(28,66)">
        <rect width="270" height="46" rx="10" fill="#131b38"/>
        <text x="16" y="29">🧩 AI Agents</text>
      </g>
      <g transform="translate(322,66)">
        <rect width="270" height="46" rx="10" fill="#131b38"/>
        <text x="16" y="29">🧠 Models</text>
      </g>
      <g transform="translate(28,124)">
        <rect width="270" height="46" rx="10" fill="#131b38"/>
        <text x="16" y="29">🛠️ Frameworks</text>
      </g>
      <g transform="translate(322,124)">
        <rect width="270" height="46" rx="10" fill="#131b38"/>
        <text x="16" y="29">🔌 MCP Servers</text>
      </g>
      <g transform="translate(28,182)">
        <rect width="270" height="46" rx="10" fill="#131b38"/>
        <text x="16" y="29">⚖️ Comparisons</text>
      </g>
      <g transform="translate(322,182)">
        <rect width="270" height="46" rx="10" fill="#131b38"/>
        <text x="16" y="29">📚 Glossary</text>
      </g>
    </g>
    <text x="28" y="270" font-size="12.5" fill="#8792b3">Live counts change as entities pass verification —</text>
    <text x="28" y="290" font-size="12.5" fill="#8792b3">see <tspan fill="#9db2ff">bestaiagent.in/catalog.json</tspan> for the current numbers.</text>
  </g>

  <!-- footer -->
  <line x1="80" y1="440" x2="1520" y2="440" stroke="#232c47"/>
  <text x="80" y="470" font-size="14" fill="#7f89ab" font-weight="700">github.com/CodesbyFebin/BESTAIAGENT-MASTER</text>
  <text x="1520" y="470" font-size="14" fill="#7f89ab" font-weight="700" text-anchor="end">bestaiagent.in</text>
</svg>
